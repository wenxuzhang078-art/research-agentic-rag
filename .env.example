# 复制为 .env，填入你自己的密钥。不要提交 .env 或分享 API Key。
DASHSCOPE_API_KEY=replace_with_your_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# 与本地 Docker Compose 一致；初始化、入库、检索使用同一 Collection。
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=mvc_hybrid_1024

# 当前 RAG / Agent 的本地检索固定使用 Rerank，正常问答必须配置基础地址。
# 代码会追加 /reranks；不要填写完整请求路径，不要直接复用 Chat 地址。
# 按实际业务空间及地域填写，参考 https://help.aliyun.com/zh/model-studio/rerank
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=

# 仅用于 Web 后端；留空不启动 MCP。相对路径按启动工作目录解析。
# 启用示例：MCP_CONFIG_PATH=configs/mcp_arxiv.json
# CLI 使用：python -m main agent --mcp-config configs/mcp_arxiv.json --show-steps
MCP_CONFIG_PATH=

# 单个 PDF 上传限制（MB）；修改后重启后端。
MAX_PDF_MB=20

# Agent Grade 的 Rerank 分数预筛门槛，范围 0..1。
GRADE_MIN_RERANK_SCORE=0.20
